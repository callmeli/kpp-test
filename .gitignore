# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# 截图和图片（可能很大，不提交到git）
screenshots/
/images/
*.png
*.jpg
*.jpeg
# 但允许 docs/images/ 目录（用于文档中的图片）
!docs/images/
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg
# 允许 web/public/images/ 目录（用于Web应用的图片资源）
!web/public/images/
!web/public/images/**/*.png
!web/public/images/**/*.jpg
!web/public/images/**/*.jpeg
# 允许站点图标和分享图（scripts/og.cjs 生成；之前被上面的 *.png 挡住，没进仓库）
!web/public/icon-*.png
!web/public/og.jpg

# 进度文件（包含临时状态）
scripts/progress.json

# 数据文件（可能包含大量数据）
data/questions.json
data/translations/*.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建输出
web/dist/
web/build/
web/.next/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.log
/tmp/

# 环境变量文件
.env
.env.local
.env.*.local

.wrangler/

# App 构建产物（npm run build:app）
web/dist-app/
# App 工程里的图标、启动图（上面的 *.png 会把它们挡住，CI 上编译会缺图）
!web/assets/*.png
!web/android/app/src/main/res/**/*.png
!web/ios/App/App/Assets.xcassets/**/*.png
